# STUB — SIEEJ via OIDC. NO se aplica hasta renombrar a `sieej-oidc.yaml`.
#
# SIEEJ es el frontend de captura estadistica (estatico, servido por gateway-hub);
# su backend vive en mariachi/api. La auth de SIEEJ admite el rol `externo`
# (dependencias de gobierno que capturan datos), a diferencia del CMS.
#
# Antes de activar:
#  1. Definir la redirect URI real del callback OIDC en el backend de SIEEJ.
#  2. Wire client_id/secret.
#  3. Renombrar a .yaml y `make restart`.
version: 1
metadata:
  name: IIEG - SIEEJ (OIDC)
  labels:
    blueprints.goauthentik.io/description: STUB OIDC para SIEEJ (captura estadistica)
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: provider-sieej
    identifiers:
      name: SIEEJ
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      sub_mode: user_email
      include_claims_in_id_token: true
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      redirect_uris:
        - matching_mode: strict
          url: !Format ["%s/sieej/auth/callback", !Env [MINERVA_EXTERNAL_URL, "https://iieg.jalisco.gob.mx"]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]

  - model: authentik_core.application
    id: app-sieej
    identifiers:
      slug: sieej
    attrs:
      name: SIEEJ
      provider: !KeyOf provider-sieej
      meta_launch_url: !Format ["%s/sieej/", !Env [MINERVA_EXTERNAL_URL, "https://iieg.jalisco.gob.mx"]]
      group: Plataforma

  # Staff + externo (las dependencias capturan datos en SIEEJ).
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-sieej
      group: !Find [authentik_core.group, [name, tetlamamakani]]
      order: 0
    attrs:
      enabled: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-sieej
      group: !Find [authentik_core.group, [name, editora]]
      order: 1
    attrs:
      enabled: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-sieej
      group: !Find [authentik_core.group, [name, proj-sieej]]
      order: 2
    attrs:
      enabled: true
