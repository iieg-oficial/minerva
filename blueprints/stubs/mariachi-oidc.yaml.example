# STUB — MARIACHI (CMS/admin) via OIDC. NO se aplica hasta renombrar a `mariachi-oidc.yaml`.
#
# MARIACHI hoy emite su propia auth (cookies HttpOnly + CSRF, ver mariachi/docs/COOKIES_CSRF.md).
# La migracion a Minerva implica que mariachi-api valide tokens OIDC de Authentik en lugar
# de su JWT propio, y mapee los claims de grupo a su RBAC (tetlamamakani / editora / externo).
#
# Antes de activar:
#  1. Definir la redirect URI real del callback OIDC en mariachi-api.
#  2. Wire client_id/secret en mariachi/.env.
#  3. Renombrar a .yaml y `make restart`.
version: 1
metadata:
  name: IIEG - MARIACHI (OIDC)
  labels:
    blueprints.goauthentik.io/description: STUB OIDC para MARIACHI (CMS / admin del ecosistema)
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: provider-mariachi
    identifiers:
      name: MARIACHI
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      sub_mode: user_email
      include_claims_in_id_token: true
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      redirect_uris:
        - matching_mode: strict
          url: !Format ["%s/administrador/auth/callback", !Env [MINERVA_EXTERNAL_URL, "https://iieg.jalisco.gob.mx"]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]

  - model: authentik_core.application
    id: app-mariachi
    identifiers:
      slug: mariachi
    attrs:
      name: MARIACHI
      provider: !KeyOf provider-mariachi
      meta_launch_url: !Format ["%s/administrador/", !Env [MINERVA_EXTERNAL_URL, "https://iieg.jalisco.gob.mx"]]
      group: Plataforma

  # Solo staff (admin global + editora). El rol externo NO entra al CMS.
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-mariachi
      group: !Find [authentik_core.group, [name, tetlamamakani]]
      order: 0
    attrs:
      enabled: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-mariachi
      group: !Find [authentik_core.group, [name, editora]]
      order: 1
    attrs:
      enabled: true
