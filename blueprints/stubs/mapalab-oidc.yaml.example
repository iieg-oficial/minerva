# STUB — MapaLab via OIDC. NO se aplica hasta renombrar a `mapalab-oidc.yaml`.
#
# MapaLab es el visor publico de mapas: hoy todos sus endpoints son anonimos.
# Esta integracion OIDC es para features futuras (preview/admin embebido) — el
# visor publico NO requiere login. Ver gateway-hub/docs/ecosystem.md seccion 5.2.
#
# Antes de activar:
#  1. Definir la redirect URI real del callback OIDC en mapalab-backend.
#  2. Wire client_id/secret en mapalab/.env.
#  3. Renombrar a .yaml y `make restart`.
version: 1
metadata:
  name: IIEG - MapaLab (OIDC)
  labels:
    blueprints.goauthentik.io/description: STUB OIDC para MapaLab (features autenticadas futuras)
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: provider-mapalab
    identifiers:
      name: MapaLab
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      sub_mode: user_email
      include_claims_in_id_token: true
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      redirect_uris:
        - matching_mode: strict
          url: !Format ["%s/mapalab/auth/callback", !Env [MINERVA_EXTERNAL_URL, "https://iieg.jalisco.gob.mx"]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]

  - model: authentik_core.application
    id: app-mapalab
    identifiers:
      slug: mapalab
    attrs:
      name: MapaLab
      provider: !KeyOf provider-mapalab
      meta_launch_url: !Format ["%s/mapalab/", !Env [MINERVA_EXTERNAL_URL, "https://iieg.jalisco.gob.mx"]]
      group: Geoespacial

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-mapalab
      group: !Find [authentik_core.group, [name, tetlamamakani]]
      order: 0
    attrs:
      enabled: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-mapalab
      group: !Find [authentik_core.group, [name, proj-mapalab]]
      order: 1
    attrs:
      enabled: true
