# STUB — GeoServer via OIDC. NO se aplica hasta renombrar a `geoserver-oidc.yaml`.
#
# Antes de activar:
#  1. Confirmar la redirect URI real del plugin geoserver-sec-oauth2-openid.
#  2. Tras aplicar el blueprint, copiar client_id / client_secret del provider
#     (Authentik > Providers) a la config OIDC de GeoServer.
#  3. Renombrar este archivo a .yaml y `make restart`.
version: 1
metadata:
  name: IIEG - GeoServer (OIDC)
  labels:
    blueprints.goauthentik.io/description: STUB OIDC para GeoServer (admin / REST)
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: provider-geoserver
    identifiers:
      name: GeoServer
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      sub_mode: user_email
      include_claims_in_id_token: true
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      redirect_uris:
        - matching_mode: strict
          url: !Format ["%s/geoserver/web/login/oauth2/code/oidc", !Env [MINERVA_EXTERNAL_URL, "https://iieg.jalisco.gob.mx"]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]

  - model: authentik_core.application
    id: app-geoserver
    identifiers:
      slug: geoserver
    attrs:
      name: GeoServer
      provider: !KeyOf provider-geoserver
      meta_launch_url: !Format ["%s/geoserver/web/", !Env [MINERVA_EXTERNAL_URL, "https://iieg.jalisco.gob.mx"]]
      group: Geoespacial

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-geoserver
      group: !Find [authentik_core.group, [name, tetlamamakani]]
      order: 0
    attrs:
      enabled: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-geoserver
      group: !Find [authentik_core.group, [name, proj-geoserver]]
      order: 1
    attrs:
      enabled: true
