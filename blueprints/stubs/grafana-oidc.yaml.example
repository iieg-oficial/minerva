# STUB — Grafana (Huachicol) via OIDC. NO se aplica hasta renombrar a `grafana-oidc.yaml`.
#
# Antes de activar:
#  1. La redirect URI debe coincidir con `root_url` de Grafana + /login/generic_oauth.
#  2. Configurar `auth.generic_oauth` en grafana.ini / env con el client_id/secret.
#  3. Renombrar a .yaml y `make restart`.
version: 1
metadata:
  name: IIEG - Grafana (OIDC)
  labels:
    blueprints.goauthentik.io/description: STUB OIDC para Grafana / Huachicol
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: provider-grafana
    identifiers:
      name: Grafana
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      sub_mode: user_email
      include_claims_in_id_token: true
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      redirect_uris:
        - matching_mode: strict
          url: !Format ["%s/huachicol/login/generic_oauth", !Env [MINERVA_EXTERNAL_URL, "https://iieg.jalisco.gob.mx"]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]

  - model: authentik_core.application
    id: app-grafana
    identifiers:
      slug: grafana
    attrs:
      name: Grafana (Huachicol)
      provider: !KeyOf provider-grafana
      meta_launch_url: !Format ["%s/huachicol/", !Env [MINERVA_EXTERNAL_URL, "https://iieg.jalisco.gob.mx"]]
      group: Observabilidad

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-grafana
      group: !Find [authentik_core.group, [name, tetlamamakani]]
      order: 0
    attrs:
      enabled: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-grafana
      group: !Find [authentik_core.group, [name, proj-huachicol]]
      order: 1
    attrs:
      enabled: true
