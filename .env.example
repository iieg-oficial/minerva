# Puertos expuestos por Docker Compose (cambiar si hay conflictos con otros proyectos,
# p.ej. al levantar Minerva junto con Godin, que usa FRONTEND_PORT=3000 y POSTGRES_PORT=5432)
BACKEND_PORT=9000
FRONTEND_PORT=3100
POSTGRES_PORT=5433
REDIS_PORT=6379

APP_NAME=Minerva
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-in-production-use-long-random-string

# ---------------------------------------------------------------------------
# Minerva Dev Kit (fuente de verdad: docs/minerva-dev-kit-context.md)
# Estas variables tienen prioridad sobre las heredadas (DATABASE_URL,
# JWT_SECRET_KEY, ACCESS_TOKEN_EXPIRE_MINUTES, MINERVA_ISSUER). Para migrar a
# una Minerva Central basta con cambiar estos valores.
# ---------------------------------------------------------------------------
MINERVA_MODE=dev
# Docker Compose: usar el host del servicio de base de datos (minerva-db o postgres)
MINERVA_DB_URL=postgresql://minerva:minerva@minerva-db:5432/minerva
MINERVA_ENABLE_DEV_LOGIN=true
MINERVA_AUTO_IMPORT_MANIFESTS=true
MINERVA_MANIFESTS_PATH=/app/manifests
MINERVA_JWT_ISSUER=http://localhost:9000
MINERVA_JWT_SECRET=dev-secret
MINERVA_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------------------------------------------------------------------------
# Variables heredadas (compatibilidad). Se usan como respaldo cuando las
# variables MINERVA_* no están definidas.
# ---------------------------------------------------------------------------
# Docker Compose: DATABASE_URL=postgresql+psycopg://minerva:minerva@postgres:5432/minerva
# Local (conda):  DATABASE_URL=postgresql+psycopg://minerva:minerva@localhost:5432/minerva
DATABASE_URL=postgresql+psycopg://minerva:minerva@postgres:5432/minerva

JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_EMAIL=admin@iieg.gob.mx
ADMIN_PASSWORD=changeme123

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9000/auth/google/callback
ALLOWED_GOOGLE_DOMAIN=iieg.gob.mx

MINERVA_ISSUER=http://localhost:9000

# ---------------------------------------------------------------------------
# OIDC / firma de tokens
# Algoritmo de firma del access token del canje (/auth/token). RS256 (JWKS) por
# defecto: los consumidores verifican con la clave pública sin secreto compartido.
# HS256 queda como respaldo de transición. El id_token SIEMPRE va firmado RS256.
# ---------------------------------------------------------------------------
MINERVA_SIGNING_ALG=RS256
# Clave maestra (Fernet) para cifrar la clave privada RSA en reposo. OBLIGATORIA
# en producción. En dev, si se deja vacía, se deriva del secreto JWT (solo dev).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MINERVA_KEY_ENCRYPTION_KEY=
# Ciclo de vida de los tokens del canje OIDC (/auth/token). El access token es
# corto y se renueva con el refresh token (que rota en cada uso). Separados del
# TTL de la sesión interna del panel (MINERVA_ACCESS_TOKEN_EXPIRE_MINUTES).
MINERVA_ACCESS_TOKEN_TTL_MINUTES=15
MINERVA_REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Redis (rate limiting, blacklist de tokens, sesiones efímeras de /authorize)
# Docker Compose: host del servicio = minerva_redis
# Local (conda):  redis://localhost:6379/0
# ---------------------------------------------------------------------------
REDIS_URL=redis://minerva_redis:6379/0
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_AUTHORIZE_MAX=20
RATE_LIMIT_AUTHORIZE_WINDOW=60
