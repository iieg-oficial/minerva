# ─────────────────────────────────────────────────────────────
# Minerva — Authentik IdP (gestor de identidad del ecosistema IIEG)
# Copiar a .env y rellenar. NUNCA commitear el .env real.
# ─────────────────────────────────────────────────────────────

# Version de la imagen de Authentik (ghcr.io/goauthentik/server:<tag>)
AUTHENTIK_VERSION=2025.8

# Clave de cifrado de Authentik. Generar con: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=<reemplazar_con_clave_aleatoria>

# ── PostgreSQL dedicado (contenedor minerva-db) ──
POSTGRES_DB=authentik
POSTGRES_USER=authentik
# Generar con: openssl rand -base64 36
POSTGRES_PASSWORD=<reemplazar_con_password_aleatorio>

# ── Usuario admin inicial (akadmin) — solo se aplica en el primer arranque ──
AUTHENTIK_BOOTSTRAP_EMAIL=admin@iieg.jalisco.gob.mx
# Generar con: openssl rand -base64 24
AUTHENTIK_BOOTSTRAP_PASSWORD=<reemplazar_con_password_aleatorio>
# Token de API para akadmin (usado por scripts/CI). Generar con: openssl rand -hex 32
AUTHENTIK_BOOTSTRAP_TOKEN=<reemplazar_con_token_aleatorio>

# ── Red / dominio ──
# Puerto local (solo 127.0.0.1) para acceso directo en la VM. El trafico publico
# entra por gateway-hub bajo /auth/.
MINERVA_HTTP_PORT=9000
# Dominio para el que Authentik emite cookies. Debe ser el dominio del gateway.
MINERVA_COOKIE_DOMAIN=iieg.jalisco.gob.mx
# URL externa completa del ecosistema (la que ve el navegador). Usada por los blueprints.
MINERVA_EXTERNAL_URL=https://iieg.jalisco.gob.mx

# ── Integraciones (consumidas por los blueprints en blueprints/) ──
# Consola de Acervo: host:puerto del Filer UI de SeaweedFS en iieg-network.
ACERVO_CONSOLE_UPSTREAM=acervo-seaweedfs:8888
