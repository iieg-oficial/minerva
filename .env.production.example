# .env de ejemplo para PRODUCCIÓN con docker-compose.deploy.yml (imágenes de ghcr).
# Copia a .env y reemplaza TODOS los valores marcados con <...>. No subas el .env real.
#
# Genera secretos con:
#   openssl rand -hex 32                                         # SECRET_KEY / *_SECRET
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # MINERVA_KEY_ENCRYPTION_KEY

# --- Imagen a desplegar ---
# MINERVA_ORG: dueño de los paquetes en ghcr.io, es decir la organización de GitHub
#   del repositorio. Solo cambia si publicas las imágenes bajo otra cuenta.
# MINERVA_VERSION: tag de la imagen en ghcr, que es el del release SIN la `v`
#   (release `v0.7.0` -> imagen `0.7.0`). El otro valor válido es `latest`, que
#   apunta al último release publicado: NO lo uses en prod, fija la versión.
MINERVA_ORG=iieg-oficial
MINERVA_VERSION=1.0.0

# Si operas desde un clon del repo, esto hace que `just up`, `just pull`, `just logs`
# y el resto de recetas usen el compose de deploy sin repetir el archivo cada vez.
MINERVA_COMPOSE=docker-compose.deploy.yml

# --- Puerto expuesto en el host (detrás de tu reverse proxy / TLS) ---
# BACKEND_PORT no aplica: el backend no se publica, solo nginx (frontend).
FRONTEND_PORT=3000

# --- URL pública real (con https si hay TLS por delante) ---
FRONTEND_URL=https://<dominio-publico>
MINERVA_JWT_ISSUER=https://<dominio-publico>
MINERVA_ISSUER=https://<dominio-publico>

# --- Aplicación ---
APP_NAME=Minerva
# APP_ENV y MINERVA_MODE son UNA sola señal: basta con que una diga producción
# para que el fail-fast exija esta plantilla completa. APP_DEBUG=true aquí aborta
# el arranque.
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=<openssl-rand-hex-32>

# --- Modo Minerva ---
MINERVA_MODE=central
MINERVA_ENABLE_DEV_LOGIN=false        # sin login de desarrollo en prod
MINERVA_AUTO_IMPORT_MANIFESTS=true
MINERVA_MANIFESTS_PATH=/app/manifests
MINERVA_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Base de datos (las 3 credenciales deben coincidir con la URL) ---
POSTGRES_DB=minerva
POSTGRES_USER=minerva
POSTGRES_PASSWORD=<password-fuerte>
MINERVA_DB_URL=postgresql://minerva:<password-fuerte>@minerva-db:5432/minerva
DATABASE_URL=postgresql+psycopg://minerva:<password-fuerte>@minerva-db:5432/minerva

# --- Firma de tokens (RS256) ---
MINERVA_JWT_SECRET=<openssl-rand-hex-32>
JWT_SECRET_KEY=<openssl-rand-hex-32>
MINERVA_KEY_ENCRYPTION_KEY=<fernet-key>       # OBLIGATORIA en prod; persístela de forma segura
MINERVA_ACCESS_TOKEN_TTL_MINUTES=15
MINERVA_REFRESH_TOKEN_TTL_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=480
MINERVA_JWKS_CACHE_TTL_SECONDS=300
MINERVA_KEY_PROPAGATION_MINUTES=60            # espera entre rotate-key y promote-key
MINERVA_CLOCK_SKEW_MINUTES=5

# --- Administrador inicial (cambia la contraseña tras el primer acceso) ---
ADMIN_EMAIL=admin@iieg.gob.mx
ADMIN_PASSWORD=<password-admin-fuerte>

# --- Redis ---
REDIS_URL=redis://minerva-redis:6379/0
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_AUTHORIZE_MAX=20
RATE_LIMIT_AUTHORIZE_WINDOW=60
