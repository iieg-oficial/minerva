{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(ruff check:*)",
            "Bash(ruff format:*)",
            "Bash(pytest:*)",
            "Bash(mypy:*)",
            "Bash(alembic upgrade:*)",
            "Bash(alembic history:*)",
            "Bash(alembic current:*)",
            "Bash(npm run lint:*)",
            "Bash(npm run build:*)",
            "Bash(npm run format:*)",
            "Bash(docker compose ps:*)",
            "Bash(docker compose logs:*)",
            "Bash(docker compose config:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./backend/.env)"
        ]
    }
}
