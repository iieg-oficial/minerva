# Manifiesto de EJEMPLO del Minerva Dev Kit (solo de referencia, no se auto-importa).
# El backend auto-importa al arrancar los archivos que matchean *.minerva.yml, *.minerva.yaml,
# manifest.yml o manifest.yaml dentro de manifests/ (ver backend/app/main.py:_auto_import_manifests).
# Este archivo usa el sufijo ".example.yml" a propósito para no matchear ese patrón.
# Cada sistema consumidor declara aquí su aplicación, permisos y roles.
# Convención de permisos: {application_code}.{resource}.{action}

application:
  code: portal_demo
  name: Portal Demo
  description: Sistema documental de ejemplo
  base_url: http://localhost:8100
  redirect_uris:
    - http://localhost:8100/callback

permissions:
  - key: portal_demo.documents.view
    name: Ver documentos
    description: Permite consultar documentos

  - key: portal_demo.documents.create
    name: Crear documentos
    description: Permite crear nuevos documentos

  - key: portal_demo.documents.authorize
    name: Autorizar documentos
    description: Permite autorizar documentos

  - key: portal_demo.requests.view
    name: Ver solicitudes
    description: Permite consultar solicitudes de información

  - key: portal_demo.requests.assign
    name: Asignar solicitudes
    description: Permite asignar solicitudes a usuarios

roles:
  - name: Consulta
    description: Usuario de solo lectura
    permissions:
      - portal_demo.documents.view
      - portal_demo.requests.view

  - name: Capturista
    description: Usuario que puede capturar información
    permissions:
      - portal_demo.documents.view
      - portal_demo.documents.create
      - portal_demo.requests.view

  - name: Administrador
    description: Control total del sistema
    permissions:
      - portal_demo.documents.view
      - portal_demo.documents.create
      - portal_demo.documents.authorize
      - portal_demo.requests.view
      - portal_demo.requests.assign
